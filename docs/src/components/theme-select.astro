---
import { Icon } from "@astrojs/starlight/components";
---

<starlight-theme-select
    data-selected="auto"
    data-direction=""
    role="group"
    aria-label={Astro.locals.t("themeSelect.accessibleLabel")}
>
    <button
        type="button"
        data-theme-choice="dark"
        aria-label={Astro.locals.t("themeSelect.dark")}
        aria-pressed="false"
    >
        <Icon name="moon" size="1.1rem" />
    </button>
    <button
        type="button"
        data-theme-choice="light"
        aria-label={Astro.locals.t("themeSelect.light")}
        aria-pressed="false"
    >
        <Icon name="sun" size="1.1rem" />
    </button>
    <button
        type="button"
        data-theme-choice="auto"
        aria-label={Astro.locals.t("themeSelect.auto")}
        aria-pressed="false"
    >
        <Icon name="desktop" size="1.1rem" />
    </button>
</starlight-theme-select>

<script>
    type Theme = "auto" | "light" | "dark";

    const storageKey = "starlight-theme";
    const systemPrefersLight = window.matchMedia(
        "(prefers-color-scheme: light)",
    );

    function savedTheme(): Theme {
        const value = localStorage.getItem(storageKey);
        return value === "light" || value === "dark" ? value : "auto";
    }

    function updateButtons(theme: Theme): void {
        document
            .querySelectorAll<HTMLElement>("starlight-theme-select")
            .forEach((selector) => {
                selector.dataset.selected = theme;
            });
        document
            .querySelectorAll<HTMLButtonElement>("[data-theme-choice]")
            .forEach((button) => {
                button.setAttribute(
                    "aria-pressed",
                    String(button.dataset.themeChoice === theme),
                );
            });
    }

    function applyTheme(theme: Theme): void {
        document.documentElement.dataset.theme =
            theme === "auto"
                ? systemPrefersLight.matches
                    ? "light"
                    : "dark"
                : theme;
        updateButtons(theme);
    }

    class StarlightThemeSelect extends HTMLElement {
        constructor() {
            super();
            this.addEventListener("click", (event) => {
                const button =
                    event.target instanceof Element
                        ? event.target.closest<HTMLButtonElement>(
                              "button[data-theme-choice]",
                          )
                        : null;
                if (!button || !this.contains(button)) return;

                const value = button.dataset.themeChoice;
                if (value !== "auto" && value !== "light" && value !== "dark")
                    return;

                localStorage.setItem(storageKey, value === "auto" ? "" : value);
                applyTheme(value);
            });
        }

        connectedCallback(): void {
            applyTheme(savedTheme());

            const buttons = Array.from(
                this.querySelectorAll<HTMLButtonElement>(
                    "button[data-theme-choice]",
                ),
            );
            let previousIndex = buttons.findIndex(
                (button) => button.dataset.themeChoice == this.dataset.selected,
            );
        }
    }

    customElements.define("starlight-theme-select", StarlightThemeSelect);
    systemPrefersLight.addEventListener("change", () => {
        if (savedTheme() === "auto") applyTheme("auto");
    });
    window.addEventListener("storage", (event) => {
        if (event.key === storageKey || event.key === null)
            applyTheme(savedTheme());
    });
</script>

<style>
    starlight-theme-select {
        display: inline-grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        padding: 0.2rem;
        gap: 0;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 5rem;
    }

    starlight-theme-select::before {
        content: "";
        grid-row: 1;
        grid-column: 1;
        border-radius: 2rem;
        background-color: var(--sl-color-accent-opaque);
        transform: translateX(var(--slide));
        padding: 0rem;
        transition:
            transform 180ms ease,
            padding 180ms ease;
        pointer-events: none;
    }

    button {
        display: flex;
        grid-row: 1;
        position: relative;
        z-index: 1;
        border: 0;
        border-radius: 2rem;
        padding: 0.35rem 0.5rem;
        background-color: transparent;
        color: var(--sl-color-gray-2);
        cursor: pointer;
        font: inherit;
        align-items: center;
        transition: color 180ms ease;
    }

    button:nth-of-type(1) {
        grid-column: 1;
    }

    button:nth-of-type(2) {
        grid-column: 2;
    }

    button:nth-of-type(3) {
        grid-column: 3;
    }

    starlight-theme-select[data-selected="dark"] {
        --slide: 0%;
    }
    starlight-theme-select[data-selected="light"] {
        --slide: 100%;
    }
    starlight-theme-select[data-selected="auto"] {
        --slide: 200%;
    }

    button:hover,
    button:focus-visible {
        color: var(--sl-color-white);
    }

    button:focus-visible {
        outline: 2px solid var(--sl-color-accent);
        outline-offset: 2px;
    }

    button[aria-pressed="true"] {
        color: var(--sl-color-white);
    }

    starlight-theme-select:has(
        > [data-theme-choice="dark"]:is(:focus-visible)
    ) {
        --slide: 0%;
    }
    starlight-theme-select:has(
        > [data-theme-choice="light"]:is(:focus-visible)
    ) {
        --slide: 100%;
    }
    starlight-theme-select:has(
        > [data-theme-choice="auto"]:is(:focus-visible)
    ) {
        --slide: 200%;
    }
    @media (prefers-reduced-motion: reduce) {
        button,
        starlight-theme-select::before {
            transition: none;
        }
    }
</style>
