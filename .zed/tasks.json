[
  {
    "label": "PlatformIO: refresh PDB switch compile database",
    "command": "pio",
    "args": [
      "run",
      "-d",
      "$ZED_WORKTREE_ROOT/onboard/firmware/pdb/switch",
      "-e",
      "ATmega328P",
      "-t",
      "compiledb"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "no_focus",
    "hide": "on_success"
  }
]
