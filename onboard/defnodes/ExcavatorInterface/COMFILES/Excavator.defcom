
Name: Excavator@localhost

RequestFormat {
    # Speeds between -500 and 500
    BoomVelocity: int
    RockBucketVelocity: int
    SandBucketVelocity: int

    # 1 or 0
    Magnet: char
    EStop: char

}


# This is used for transactional communications in the same format as above
ResponseFormat {

}
